# Database connection URL (defaults to SQLite; swap with PostgreSQL DSN in production)
DATABASE_URL=sqlite:///./data/app.db

# Application logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Directory where trained ML models and artifacts are stored
MODEL_DIR=./models

# Server configuration
API_PORT=8000
STREAMLIT_PORT=8501

# Optional: LLM integration key (for extended career coaching)
OPENAI_API_KEY=
